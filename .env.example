# Public origin, used for canonical URLs, the sitemap and checkout returns.
NEXT_PUBLIC_SITE_URL=https://kitsu-lab.vercel.app

# Dodo Payments (https://dodopayments.com). Use test_mode until launch.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Product ids for each plan in lib/pro-plans.ts. A plan without one shows "Opening soon".
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_PERSONAL=
DODO_PRODUCT_TEAM=

# Extra license keys that always work (testers, gifts), comma separated, 16+ characters each.
KITSU_PRO_KEYS=

# Optional: a Discord or Slack incoming webhook that gets one line per sale.
KITSU_SALES_WEBHOOK_URL=
