fset=\"0.687031\" stop-color=\"#101010\"/>\n<stop offset=\"0.983465\" stop-color=\"#1B1B1B\"/>\n<stop offset=\"1\" stop-color=\"#48494A\"/>\n</linearGradient>\n<linearGradient id=\"paint1_linear_0_4\" x1=\"378.511\" y1=\"234.926\" x2=\"26.4822\" y2=\"234.926\" gradientUnits=\"userSpaceOnUse\">\n<stop stop-color=\"#1C1D1D\"/>\n<stop offset=\"0.307296\" stop-color=\"#3E3D3E\"/>\n<stop offset=\"0.37856\" stop-color=\"#A8A4A6\"/>\n<stop offset=\"0.501382\" stop-color=\"#717171\"/>\n<stop offset=\"0.911206\" stop-color=\"#5B5B5A\"/>\n<stop offset=\"0.960289\" stop-color=\"#9E9E9F\"/>\n<stop offset=\"1\" stop-color=\"#4C4D4D\"/>\n</linearGradient>\n<radialGradient id=\"paint2_radial_0_4\" cx=\"0\" cy=\"0\" r=\"1\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"translate(209.234 324.207) rotate(-101.139) scale(231.496 267.716)\">\n<stop stop-opacity=\"0.8\"/>\n<stop offset=\"1\" stop-opacity=\"0\"/>\n</radialGradient>\n</defs>\n</svg>\n",
